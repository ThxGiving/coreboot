chip soc/intel/alderlake

	register "tcc_offset" = "10"

	# Match stock: PL1 = 15 W / PL2 = 20 W (N100 SoC default is 6/7 W)
	register "power_limits_config[ADL_N_041_6W_CORE]" = "{
		.tdp_pl1_override = 15,
		.tdp_pl2_override = 20,
	}"

	# GPE0 dword routing (three distinct groups required)
	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_E"

	device domain 0 on
		device ref igpu on
			# External HDMI + DP only, no embedded panel.
			# HDMI-A-1 = DDI_PORT_B, DP-1 = DDI_PORT_1 (TC1).
			register "ddi_portA_config" = "0"
			register "ddi_portB_config" = "0"
			register "ddi_ports_config" = "{
				[DDI_PORT_B] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
				[DDI_PORT_1] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
			}"
		end

		device ref xhci on
			register "usb2_ports" = "{
				[0] = USB2_PORT_MID(OC_SKIP),	/* Front USB3 #1 companion */
				[1] = USB2_PORT_MID(OC_SKIP),	/* Front USB3 #2 companion */
				[2] = USB2_PORT_MID(OC_SKIP),	/* Front USB2 #1 */
				[3] = USB2_PORT_MID(OC_SKIP),	/* Front USB2 #2 */
				[4] = USB2_PORT_MID(OC_SKIP),	/* F_USB header 1 (HS5) */
				[5] = USB2_PORT_MID(OC_SKIP),	/* F_USB header 2 (HS6) */
				[6] = USB2_PORT_MID(OC_SKIP),	/* unused */
				[7] = USB2_PORT_MID(OC_SKIP),	/* M.2 B-key WWAN */
				[8] = USB2_PORT_MID(OC_SKIP),	/* unused */
				[9] = USB2_PORT_MID(OC_SKIP),	/* CNVi Bluetooth */
			}"

			register "usb3_ports" = "{
				[0] = USB3_PORT_DEFAULT(OC_SKIP),	/* Front USB3 #1 */
				[1] = USB3_PORT_DEFAULT(OC_SKIP),	/* Front USB3 #2 */
			}"

			chip drivers/usb/acpi
				device ref xhci_root_hub on
					# Front USB3 Type-A, top-right jack (SS + USB2 companion)
					chip drivers/usb/acpi
						register "desc" = ""Front USB Type-A (top right)""
						register "type" = "UPC_TYPE_USB3_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, RIGHT, ACPI_PLD_GROUP(0, 1))"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""Front USB Type-A (top right)""
						register "type" = "UPC_TYPE_USB3_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, RIGHT, ACPI_PLD_GROUP(0, 1))"
						device ref usb3_port1 on end
					end
					# Front USB3 Type-A, bottom-right jack (SS + USB2 companion)
					chip drivers/usb/acpi
						register "desc" = ""Front USB Type-A (bottom right)""
						register "type" = "UPC_TYPE_USB3_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, RIGHT, ACPI_PLD_GROUP(0, 2))"
						device ref usb2_port2 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""Front USB Type-A (bottom right)""
						register "type" = "UPC_TYPE_USB3_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, RIGHT, ACPI_PLD_GROUP(0, 2))"
						device ref usb3_port2 on end
					end
					# Front USB 2.0 Type-A, left column
					chip drivers/usb/acpi
						register "desc" = ""Front USB 2.0 (top left)""
						register "type" = "UPC_TYPE_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, LEFT, ACPI_PLD_GROUP(0, 3))"
						device ref usb2_port3 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""Front USB 2.0 (bottom left)""
						register "type" = "UPC_TYPE_A"
						register "use_custom_pld" = "true"
						register "custom_pld" = "ACPI_PLD_TYPE_A(FRONT, LEFT, ACPI_PLD_GROUP(0, 4))"
						device ref usb2_port4 on end
					end
					# Internal 2x5 USB 2.0 header (F_USB)
					chip drivers/usb/acpi
						register "desc" = ""F_USB header 1""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port5 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""F_USB header 2""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port6 on end
					end
					# M.2 B-key WWAN (internal)
					chip drivers/usb/acpi
						register "desc" = ""M.2 WWAN""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port8 on end
					end
					# CNVi Bluetooth (USB2 port 10, no reset GPIO): drivers/usb/acpi
					# emits its reset _DSM + PLDR _RST (CB:93839).
					chip drivers/usb/acpi
						register "desc" = ""CNVi Bluetooth""
						register "type" = "UPC_TYPE_INTERNAL"
						register "is_intel_bluetooth" = "true"
						device ref usb2_port10 on end
					end
				end
			end
		end

		device ref shared_sram on end
		device ref crashlog off end

		# SATA ports 0 + 1 (stock AHCI PI = 0x03)
		device ref sata on
			register "sata_ports_enable[0]" = "1"
			register "sata_ports_enable[1]" = "1"
		end

		# 4x Intel I226-V. clk_src (CLKOUT index) follows RP enumeration
		# order: RP3->0, RP4->1, RP7->2, RP9->3, RP12->4.
		device ref pcie_rp3 on	# ETH0
			device pci 00.0 on
				smbios_dev_info 0 "ETH0"
			end
			register "pch_pcie_rp[PCH_RP(3)]" = "{
				.clk_src = 0,
				.clk_req = 5,
				.flags = PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
		end

		device ref pcie_rp4 on	# ETH1
			device pci 00.0 on
				smbios_dev_info 1 "ETH1"
			end
			register "pch_pcie_rp[PCH_RP(4)]" = "{
				.clk_src = 1,
				.clk_req = 1,
				.flags = PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
		end

		device ref pcie_rp7 on	# ETH2
			device pci 00.0 on
				smbios_dev_info 2 "ETH2"
			end
			register "pch_pcie_rp[PCH_RP(7)]" = "{
				.clk_src = 2,
				.clk_req = 2,
				.flags = PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
		end

		device ref pcie_rp9 on	# ETH3
			device pci 00.0 on
				smbios_dev_info 3 "ETH3"
			end
			register "pch_pcie_rp[PCH_RP(9)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
		end

		# M.2 NVMe (RP12)
		device ref pcie_rp12 on
			register "pch_pcie_rp[PCH_RP(12)]" = "{
				.clk_src = 4,
				.clk_req = 0,
				.flags = PCIE_RP_CLK_REQ_DETECT,
				.pcie_rp_aspm = ASPM_DISABLE,
				.PcieRpL1Substates = L1_SS_DISABLED,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 (NVMe)" "SlotDataBusWidth1X"
		end

		# M.2 2230 E-key CNVi (AX211/AX201). A discrete PCIe card would
		# need pcie_rp1 + a spare clock (all 5 are used by NICs + NVMe).
		device ref cnvi_wifi on
			# BT core reaches the host over USB2; Wi-Fi alone doesn't enable it
			register "cnvi_bt_core" = "true"
			smbios_slot_desc "SlotTypeM2Socket1_SD" "SlotLengthOther" "M.2/E 2230 (CNVi WiFi/BT)" "SlotDataBusWidth1X"
		end

		device ref pch_espi on
			chip superio/ite/it8625e
				register "ec.vin_mask" = "VIN_ALL"
				register "TMPIN1.mode"   = "THERMAL_DIODE"	# CPU
				register "TMPIN2.mode"   = "THERMAL_DIODE"	# board
				register "TMPIN3.mode"   = "THERMAL_MODE_DISABLED"
				# Diode offset calibration (stock regs 0x56 / 0x57)
				register "TMPIN1.offset" = "0x68"
				register "TMPIN2.offset" = "0x60"
				# CPU fan (J2G1) = FAN1/pwm1, SmartGuardian by CPU temp
				register "FAN1.mode"		= "FAN_SMART_AUTOMATIC"
				register "FAN1.smart.tmpin"	= "1"
				register "FAN1.smart.tmp_off"	= "45"
				register "FAN1.smart.tmp_start"	= "52"
				register "FAN1.smart.tmp_full"	= "85"
				register "FAN1.smart.tmp_delta"	= "3"
				register "FAN1.smart.pwm_start"	= "30"
				register "FAN1.smart.slope"	= "8"
				register "FAN2.mode"		= "FAN_MODE_OFF"
				register "FAN3.mode"		= "FAN_MODE_OFF"
				device pnp 2e.1 on	# COM1
					io 0x60 = 0x3f8
					irq 0x70 = 0x4
					irq 0xf0 = 0x1
				end
				device pnp 2e.2 on	# COM2 header
					io 0x60 = 0x2f8
					irq 0x70 = 0x3
					irq 0xf0 = 0x1
				end
				device pnp 2e.4 on	# Environment Controller (HWM)
					io 0x60 = 0xa30
					io 0x62 = 0xa20
					# Required, not cosmetic: the IT8625E powers up with its
					# interrupt on IRQ 9, which is the ACPI SCI. Run fanless,
					# the HWM then asserts a fan fault and drives IRQ 9
					# continuously with no status bit to ack, and Linux masks
					# the SCI. The sensors are polled, so route no IRQ.
					irq 0x70 = 0x00
				end
				device pnp 2e.7 on	# GPIO (user header)
					# only the used base is declared; leaving 0x60/0x64
					# undeclared avoids an "LPC IO decode base 0!" window
					io 0x62 = 0x0a00
					irq 0x70 = 0x00
				end
				device pnp 2e.3 off end	# LPT
				device pnp 2e.5 off end	# PS/2 keyboard
				device pnp 2e.6 off end	# PS/2 mouse
				device pnp 2e.8 off end	# consumer IR
			end
		end

		device ref smbus on end
		device ref fast_spi on end

		device ref hda on
			register "pch_hda_audio_link_hda_enable"	= "true"
			register "pch_hda_dsp_enable"			= "true"
			register "pch_hda_idisp_codec_enable"		= "true"
			register "pch_hda_idisp_link_frequency"		= "HDA_LINKFREQ_96MHZ"
			register "pch_hda_idisp_link_tmode"		= "HDA_TMODE_8T"
		end

		chip drivers/crb
			device mmio 0xfed40000 on end
		end
	end
end
