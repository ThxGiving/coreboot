CONFIG_BOOTSPLASH_IMAGE=y
CONFIG_BOOTSPLASH_FILE="src/mainboard/bkhd/1264np_12_4l/bootsplash.jpg"
CONFIG_VENDOR_BKHD=y
CONFIG_FMDFILE="src/mainboard/bkhd/1264np_12_4l/board.fmd"
# CONFIG_PCIEXP_ASPM is not set
# CONFIG_PCIEXP_L1_SUB_STATE is not set
CONFIG_BOARD_BKHD_1264NP_12_4L=y
CONFIG_CONSOLE_CBMEM_BUFFER_SIZE=0x400000
CONFIG_USE_LEGACY_8254_TIMER=y
# CONFIG_EDK2_FULL_SCREEN_SETUP is not set
CONFIG_TCSS_HAS_USBC_OPS=y
CONFIG_BOOTSPLASH=y
CONFIG_ELOG=y
# CONFIG_TPM_PPI is not set
# CONFIG_FSP_ENABLE_SERIAL_DEBUG is not set
CONFIG_CONSOLE_FRAMEBUFFER=y
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_6=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_USE_EDK2_PLATFORMS=y
CONFIG_EDK2_SD_MMC_TIMEOUT=1
CONFIG_EDK2_SERIAL_SUPPORT=y
